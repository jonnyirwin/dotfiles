# Catppuccin Mocha — matches the mako config and waybar pill aesthetic.

[global]
# Monitor
monitor = -1
follow = keyboard

# Placement
origin = top-right
offset = (8, 8)
width = (0, 360)
height = (0, 140)
notification_limit = 5
layer = overlay

# Visual
background = "#313244"
foreground = "#cdd6f4"
frame_color = "#45475a"
separator_color = frame
highlight = "#cba6f7"
corner_radius = 18
frame_width = 1
padding = 14
horizontal_padding = 14
gap_size = 8
font = "Dank Mono 14"
markup = full
format = "<span foreground='#cba6f7' weight='bold'>%s</span>\n<span foreground='#bac2de'>%b</span>"
alignment = left
vertical_alignment = center
word_wrap = yes
ellipsize = middle
ignore_newline = no
stack_duplicates = true
hide_duplicate_count = false
show_indicators = yes

# Timing
timeout = 5
idle_threshold = 120

# Interaction
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

# Progress bar
progress_bar = true
progress_bar_height = 10
progress_bar_frame_width = 1
progress_bar_min_width = 150
progress_bar_max_width = 300

# History
history_length = 20
show_age_threshold = 60

# Icons
icon_position = left
min_icon_size = 32
max_icon_size = 48
icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/:/usr/share/icons/Adwaita/16x16/status/:/usr/share/icons/Adwaita/16x16/devices/:/usr/share/pixmaps/

browser = /usr/bin/xdg-open

[urgency_low]
background = "#313244"
foreground = "#cdd6f4"
frame_color = "#6c7086"
timeout = 3
format = "<span foreground='#6c7086' weight='bold'>%s</span>\n<span foreground='#bac2de'>%b</span>"

[urgency_normal]
background = "#313244"
foreground = "#cdd6f4"
frame_color = "#45475a"
timeout = 5

[urgency_critical]
background = "#313244"
foreground = "#cdd6f4"
frame_color = "#f38ba8"
timeout = 0
format = "<span foreground='#f38ba8' weight='bold'>%s</span>\n<span foreground='#bac2de'>%b</span>"

[volume_notification]
summary = "*Volume*"
urgency = low
timeout = 2
history_ignore = yes

[brightness_notification]
summary = "*Brightness*"
urgency = low
timeout = 2
history_ignore = yes

[spotify_notification]
appname = "Spotify"
format = "<span foreground='#cba6f7' weight='bold'>♫ %s</span>\n<span foreground='#bac2de'>%b</span>"
urgency = low
timeout = 5
