# Catppuccin Mocha — matches the waybar pill aesthetic.

font=SF Mono 13
background-color=#313244
text-color=#cdd6f4
border-color=#45475a
border-size=1
border-radius=10
progress-color=over #45475a

width=360
height=140
padding=14
margin=8
anchor=top-right
layer=overlay
default-timeout=5000
icons=1
max-icon-size=48

markup=1
format=<span foreground="#cba6f7" weight="bold">%s</span>\n<span foreground="#bac2de">%b</span>

[urgency=low]
border-color=#6c7086
default-timeout=3000
format=<span foreground="#6c7086" weight="bold">%s</span>\n<span foreground="#bac2de">%b</span>

[urgency=high]
border-color=#f38ba8
default-timeout=0
format=<span foreground="#f38ba8" weight="bold">%s</span>\n<span foreground="#bac2de">%b</span>
