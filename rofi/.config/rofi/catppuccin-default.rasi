/* ──────────────────────────────────────────────────────────
   Rofi — pill theme to match waybar + tmux status
   Mantle canvas · surface0 capsules · mauve focus pill
   (crust-on-mauve mirrors #workspaces button.focused and
    tmux's window-status-current-format)
   ────────────────────────────────────────────────────────── */

@import "catppuccin-mocha"

* {
  font: "Dank Mono 14";

  background-color:            transparent;
  text-color:                  @text;

  border-color:                @surface1;
  separatorcolor:              transparent;

  normal-background:           transparent;
  normal-foreground:           @text;
  alternate-normal-background: transparent;
  alternate-normal-foreground: @text;
  selected-normal-background:  @mauve;
  selected-normal-foreground:  @crust;

  active-background:           transparent;
  active-foreground:           @blue;
  alternate-active-background: transparent;
  alternate-active-foreground: @blue;
  selected-active-background:  @blue;
  selected-active-foreground:  @crust;

  urgent-background:           transparent;
  urgent-foreground:           @red;
  alternate-urgent-background: transparent;
  alternate-urgent-foreground: @red;
  selected-urgent-background:  @red;
  selected-urgent-foreground:  @crust;
}

/* ── outer card ─────────────────────────────────
   Mantle like waybar, subtle surface1 outline for
   depth when floating over the desktop.
─────────────────────────────────────────────── */
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            640px;
    border:           1px solid;
    border-radius:    18px;
    border-color:     @surface1;
    padding:          14px;
    background-color: @mantle;
    cursor:           "default";
}

mainbox {
    enabled:          true;
    spacing:          10px;
    padding:          0;
    background-color: transparent;
    children:         [ "inputbar", "message", "listview" ];
}

/* ── search: one waybar-style surface0 pill ──── */
inputbar {
    enabled:          true;
    spacing:          10px;
    padding:          0 16px;
    min-height:       40px;
    background-color: @surface0;
    border-radius:    999px;
    text-color:       @text;
    children:         [ "prompt", "entry", "num-filtered-rows", "textbox-num-sep", "num-rows" ];
}

prompt {
    padding:          0 2px 0 0;
    background-color: transparent;
    text-color:       @mauve;
    vertical-align:   0.5;
}

entry {
    padding:          0;
    background-color: transparent;
    text-color:       @text;
    cursor:           text;
    placeholder:      "search…";
    placeholder-color: @overlay1;
    vertical-align:   0.5;
}

num-filtered-rows {
    expand:           false;
    background-color: transparent;
    text-color:       @overlay1;
    vertical-align:   0.5;
}

num-rows {
    expand:           false;
    background-color: transparent;
    text-color:       @overlay1;
    vertical-align:   0.5;
}

textbox-num-sep {
    expand:           false;
    str:              "/";
    background-color: transparent;
    text-color:       @overlay0;
    vertical-align:   0.5;
}

case-indicator {
    spacing:          0;
    background-color: transparent;
    text-color:       @overlay1;
    vertical-align:   0.5;
}

/* ── hit list ─────────────────────────────────── */
listview {
    enabled:          true;
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    fixed-height:     false;
    fixed-columns:    true;
    spacing:          2px;
    padding:          6px 2px 0 2px;
    background-color: transparent;
    cursor:           "default";
}

element {
    enabled:          true;
    spacing:          10px;
    padding:          0 14px;
    min-height:       34px;
    border-radius:    999px;
    background-color: transparent;
    text-color:       @text;
    cursor:           pointer;
}

element normal.normal    { background-color: transparent; text-color: @text;  }
element alternate.normal { background-color: transparent; text-color: @text;  }
element selected.normal  { background-color: @mauve;      text-color: @crust; }
element normal.active    { background-color: transparent; text-color: @blue;  }
element alternate.active { background-color: transparent; text-color: @blue;  }
element selected.active  { background-color: @blue;       text-color: @crust; }
element normal.urgent    { background-color: transparent; text-color: @red;   }
element alternate.urgent { background-color: transparent; text-color: @red;   }
element selected.urgent  { background-color: @red;        text-color: @crust; }

element-icon {
    size:             22px;
    padding:          0 6px 0 0;
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    highlight:        bold #fab387;
    vertical-align:   0.5;
}

/* ── messages & errors ────────────────────────── */
message {
    padding:          0;
    margin:           0;
    background-color: transparent;
    border:           0;
}

textbox {
    padding:          6px 14px;
    border-radius:    999px;
    background-color: @surface0;
    text-color:       @text;
}

error-message {
    padding:          8px 14px;
    border-radius:    999px;
    background-color: @red;
    text-color:       @crust;
}
