{
    "modules-left": ["custom/pomodoro", "sway/workspaces"],
    "modules-center": ["custom/music"],
    "modules-right": ["cpu", "memory", "pulseaudio", "idle_inhibitor", "clock", "tray"],
    "custom/pomodoro": {
        "format": "{}",
        "return-type": "json",
        "interval": 1,
        "exec": "~/.config/waybar/scripts/pomodoro.sh display",
        "on-click": "~/.config/waybar/scripts/pomodoro-menu.sh",
        "escape": true
    },
    "cpu": {
        "format": "  {usage:>3}%",
        "interval": 5,
        "tooltip": false
    },
    "memory": {
        "format": "  {percentage:>3}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\uf0f4",
            "deactivated": "\uf186"
        }
    },
    "clock": {
        "timezone": "Europe/Isle_of_Man",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "󰃭  {:%Y-%m-%d}",
        "format": "󰥔  {:%H:%M}"
    },
    "pulseaudio": {
        "format": "{icon}  {volume:>3}%",
        "format-muted": "\uf6a9   ---%",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "~/.config/waybar/scripts/audio-switch.sh"
    }
}
