{
    "modules-left": [
        "custom/pomodoro",
        "sway/workspaces"
    ],
    "modules-center": [
        "custom/music"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "custom/ip",
        "pulseaudio",
        "idle_inhibitor",
        "clock",
        "tray"
    ],
    "custom/pomodoro": {
        "format": "{}",
        "return-type": "json",
        "interval": 1,
        "exec": "~/.config/waybar/scripts/pomodoro.sh display",
        "on-click": "~/.config/waybar/scripts/pomodoro-menu.sh",
        "escape": true
    },
    "cpu": {
        "format": "󰍛  {usage:>3}%",
        "interval": 5,
        "tooltip": false
    },
    "memory": {
        "format": "󰘚  {percentage:>3}%",
        "format-alt": "󰘚  {used:0.1f}G / {total:0.0f}G",
        "interval": 5,
        "signal": 8,
        "on-click": "pkill -SIGRTMIN+8 waybar"
    },
    "custom/ip": {
        "format": "{}",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "exec": "~/.config/waybar/scripts/ip.sh",
        "on-click": "~/.config/waybar/scripts/ip.sh toggle",
        "escape": true
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "clock": {
        "timezone": "Europe/Isle_of_Man",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "󰃭  {:%Y-%m-%d}",
        "format": "󰥔  {:%H:%M}"
    },
    "pulseaudio": {
        "format": "{icon}  {volume:>3}%",
        "format-muted": "  ---%",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    }
}
